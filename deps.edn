;; GHOST HACKER: LIGHTNING — pure .cljc wave/health/timing core (ADR-2607023200
;; #10, Ren solo). No shared-lib dependency (unlike FLOW/HARMONY's
;; ghosthacker-groove-core) -- LIGHTNING's mechanic (continuous survival
;; under wave pressure: fire a fixed number of shots per wave, timed against
;; a periodic target-flash, health drains when a wave ends with Daemons
;; still standing) is distinct from the beat-grid rhythm titles, so it gets
;; its own small timing helper instead of reusing groove-core.
{:paths ["src"]

 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.09.27"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}
  ;; Browser host adapter (ADR-2607100900 follow-up (b)): plain reagent,
  ;; Web Audio for the periodic target-flash clock + a synthesized blip
  ;; (same shape as FLOW/HARMONY's Web Audio host, but driving LIGHTNING's
  ;; own shot-timing judgment instead of ghosthacker-groove-core's).
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      reagent/reagent           {:mvn/version "1.2.0"}
                      thheller/shadow-cljs      {:mvn/version "2.28.20"}}}}}
